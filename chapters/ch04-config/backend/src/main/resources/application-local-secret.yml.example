# ──────────────────────────────────────────────────────────────────────
# 시크릿 파일 템플릿.
# 사용법:
#   cp application-local-secret.yml.example application-local-secret.yml
#   # 그리고 아래 값을 진짜 키로 바꿔라 (학습용이면 그냥 둬도 됨)
#
# 진짜 파일(application-local-secret.yml) 은 레포 루트 .gitignore 가 차단한다.
# `git check-ignore -v application-local-secret.yml` 로 차단 여부 확인 가능.
# ──────────────────────────────────────────────────────────────────────
anvil:
  sender:
    # 마스킹 시연용 형식 — sk- 로 시작, 끝 4글자가 식별자
    api-key: "sk-localdev-1234567890abcd"
