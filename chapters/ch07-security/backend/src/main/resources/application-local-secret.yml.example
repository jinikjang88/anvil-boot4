# ──────────────────────────────────────────────────────────────────────
# ch07-security 시크릿 템플릿.
#
#   cp application-local-secret.yml.example application-local-secret.yml
#
# 진짜 파일(application-local-secret.yml) 은 레포 루트 .gitignore 가 차단한다.
#
# 키 생성 예 (운영에선 다른 값 사용):
#   openssl rand -base64 32   # JWT secret / AES master key 둘 다 32바이트 base64
# ──────────────────────────────────────────────────────────────────────
anvil:
  security:
    jwt:
      secret: "kQ5pT8zR3vL9xH7nB2cF1mY4wK6jD0aE3gP7sQuV8xY="
    encryption:
      master-key: "9aE1bC2dF3gH4iJ5kL6mN7oP8qR9sT0uvWxYzABCDEF="
